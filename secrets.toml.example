# Copy this file to .streamlit/secrets.toml and fill in your values.
# NEVER commit the real secrets.toml (it is git-ignored).

# ── Groq AI (required for all AI features) ────────────────────────────────
# Single key:
GROQ_API_KEY = "gsk_your_key_here"
# Or multiple keys for automatic rotation:
# GROQ_API_KEYS = ["gsk_key_1", "gsk_key_2"]

# ── MongoDB (required for login/signup + ratings) ─────────────────────────
MONGO_URI = "mongodb+srv://user:password@cluster.mongodb.net/"

# ── JWT signing secret for "stay logged in" cookies ───────────────────────
JWT_SECRET = "change-this-to-a-long-random-string"
